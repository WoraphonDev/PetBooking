# ตัวอย่างเท่านั้น — ค่าจริงใส่โดยมนุษย์ใน hosting / GitHub Actions secrets (ดู docs/spec/01-architecture.md §6)
# ห้าม commit ไฟล์ .env ที่มีค่าจริง
DATABASE_URL=postgres://app:app@localhost:5432/pj8
APP_BASE_URL=http://localhost:3000
APP_ENCRYPTION_KEY=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
SMTP_URL=
MAIL_FROM="PJ-8 <no-reply@example.com>"
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# dev/E2E เท่านั้น — server ปฏิเสธการ start ถ้า NODE_ENV=production และ LINE_FAKE=1
LINE_FAKE=1
