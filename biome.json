{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["**", "!docs", "!tools", "!**/migrations", "!**/node_modules", "!**/.next", "!**/*.generated.json", "!pnpm-lock.yaml"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "warn", "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } } },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "warn" }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "**/scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" }, "style": { "noNonNullAssertion": "off", "useTemplate": "off" } } }
    },
    {
      "includes": ["packages/db/src/schema/**"],
      "linter": { "rules": { "correctness": { "noUnusedFunctionParameters": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
